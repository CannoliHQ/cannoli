diff --git a/network/netplay/netplay_frontend.c b/network/netplay/netplay_frontend.c
index d616aabf33..bdd95e90d4 100644
--- a/network/netplay/netplay_frontend.c
+++ b/network/netplay/netplay_frontend.c
@@ -6356,8 +6356,14 @@ static bool netplay_get_cmd(netplay_t *netplay,
                      && !netplay_is_spectating())
                {
                   const char* msg = msg_hash_to_str(MSG_CHEEVOS_HARDCORE_MODE_REQUIRES_NEWER_HOST);
+#ifdef HAVE_RICOTTA_OSD
+                  /* Cannoli already draws this as the hardcore-paused pill (type 11), fired
+                   * by the rcheevos_pause_hardcore below. Suppress RetroArch's own message
+                   * for the same cause so it does not render twice. */
+#else
                   runloop_msg_queue_push(msg, strlen(msg), 0, 180, true, NULL,
                      MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+#endif
                   RARCH_WARN("[Netplay] Server did not send achievement information.\n", msg);
 
                   rcheevos_pause_hardcore();
@@ -7920,8 +7926,10 @@ static bool netplay_process_savestate1(retro_ctx_serialize_info_t* serial_info)
          if (hardcore_state != rcheevos_hardcore_active() && !netplay_is_spectating())
          {
             const char *msg = msg_hash_to_str(MSG_CHEEVOS_HARDCORE_MODE_CHANGED_BY_HOST);
+#ifndef HAVE_RICOTTA_OSD
             runloop_msg_queue_push(msg, strlen(msg), 0, 180, true, NULL,
                   MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+#endif
 
             if (!hardcore_state)
             {
@@ -7934,6 +7942,16 @@ static bool netplay_process_savestate1(retro_ctx_serialize_info_t* serial_info)
                 * stay off, even if the server is playing with hardcore restrictions now. we
                 * don't want to force hardcore unlocks for a player that doesn't want them. */
                rcheevos_hardcore_enabled_changed();
+#ifdef HAVE_RICOTTA_OSD
+               /* Only this direction reaches here without a pill: enabling runs
+                * rcheevos_hardcore_enabled_changed, which never calls
+                * rcheevos_pause_hardcore, so nothing else would announce it. The disable
+                * direction is suppressed above because the pause funnel draws the type 11
+                * pill for it. Cannoli has no netplay surface of its own, so RetroArch's
+                * message stays the voice here. */
+               runloop_msg_queue_push(msg, strlen(msg), 0, 180, true, NULL,
+                     MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+#endif
             }
          }
 
