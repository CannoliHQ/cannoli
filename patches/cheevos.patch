@@ -1491,6 +1540,12 @@ static void rcheevos_client_login_callback(int result,
    if (result != RC_OK)
    {
       settings_t* settings = config_get_ptr();
+#ifdef HAVE_RICOTTA_OSD
+      /* Captured before the branch below clears the token. Upstream treats an expired
+       * token and an invalid stored one identically: both mean "log in again". */
+      const bool ricotta_reauth = (result == RC_EXPIRED_TOKEN ||
+            (result == RC_INVALID_CREDENTIALS && settings->arrays.cheevos_token[0]));
+#endif
       char msg[256];
       size_t _len = strlcpy(msg, "RetroAchievements login failed: ",
             sizeof(msg));
@@ -1510,8 +1565,13 @@ static void rcheevos_client_login_callback(int result,
                sizeof(msg));
       }
 
+#ifdef HAVE_RICOTTA_OSD
+      /* Cannoli owns the login-failure notification (type 12; slot 1 = must sign in again). */
+      ricotta_osd_event(RICOTTA_OSD_CHEEVOS_LOGIN_FAILED, ricotta_reauth ? 1 : 0);
+#else
       runloop_msg_queue_push(msg, _len, 0, 2 * 60, false, NULL,
             MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_ERROR);
+#endif
       return;
    }
 
