    }
 
 #ifdef HAVE_AUDIOMIXER
@@ -801,7 +808,14 @@ void rcheevos_pause_hardcore(void)
    rcheevos_locals.hardcore_allowed = false;
 
    if (rcheevos_hardcore_active())
+   {
       rcheevos_toggle_hardcore_paused();
+#ifdef HAVE_RICOTTA_OSD
+      /* Cannoli owns the hardcore-paused notification (type 11). Every cause funnels
+       * here: state load, cheat applied, disallowed setting, SRAM load. */
+      ricotta_osd_event(RICOTTA_OSD_HARDCORE_PAUSED, 0);
+#endif
+   }
 }
 
 bool rcheevos_unload(void)
