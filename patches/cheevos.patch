+#ifdef HAVE_RICOTTA_CHEEVOS
+/* A state applied before the achievement set has arrived is every resumed launch: the load is
+ * local and the set is a network round trip, so rcheevos_set_serialized_data refuses the block
+ * and nothing revisits it, which silently restarts whatever the save had accumulated. Hold the
+ * block and apply it once the set is up.
+ *
+ * Softcore only. Hardcore's relationship with save states is RetroArch's own and stays untouched. */
+static uint8_t* ricotta_pending_progress      = NULL;
+static size_t   ricotta_pending_progress_size = 0;
+
+static void ricotta_cheevos_forget_progress(void)
+{
+   if (ricotta_pending_progress)
+      free(ricotta_pending_progress);
+   ricotta_pending_progress      = NULL;
+   ricotta_pending_progress_size = 0;
+}
+
+void ricotta_cheevos_stash_progress(const void* buffer, size_t size)
+{
+   ricotta_cheevos_forget_progress();
+
+   /* Refused with a game already loaded is a real deserialize failure rather than an ordering
+    * problem, and holding that for later would answer a question nobody asked. */
+   if (rcheevos_is_game_loaded())
+      return;
+   if (!buffer || size == 0)
+      return;
+   if (!(ricotta_pending_progress = (uint8_t*)malloc(size)))
+      return;
+
+   memcpy(ricotta_pending_progress, buffer, size);
+   ricotta_pending_progress_size = size;
+}
+
+static void ricotta_cheevos_apply_pending_progress(void)
+{
+   /* Taken before it is read. This runs from the load callback, which can be on the background
+    * thread while another state load is arriving, so whoever takes the buffer owns freeing it. */
+   uint8_t* progress = ricotta_pending_progress;
+   size_t   size     = ricotta_pending_progress_size;
+
+   ricotta_pending_progress      = NULL;
+   ricotta_pending_progress_size = 0;
+
+   if (!progress)
+      return;
+
+   if (!rcheevos_hardcore_active())
+   {
+      CHEEVOS_LOG(RCHEEVOS_TAG "Applying achievement progress carried by the loaded state\n");
+      rc_client_deserialize_progress_sized(rcheevos_locals.client, progress, size);
+   }
+
+   free(progress);
+}
+#endif
