--- a/cheat_manager.c
+++ b/cheat_manager.c
@@ -71,8 +71,15 @@ static void cheat_manager_pause_cheevos(void)
    char msg[128];
    size_t _len = strlcpy(msg, msg_hash_to_str(MSG_CHEEVOS_HARDCORE_MODE_DISABLED_CHEAT), sizeof(msg));
    rcheevos_pause_hardcore();
+#ifdef HAVE_RICOTTA_OSD
+   /* Cannoli already draws this as the hardcore-paused pill (type 11), fired by
+    * rcheevos_pause_hardcore above. Suppress RetroArch's own message for the same
+    * cause so it does not render twice. */
