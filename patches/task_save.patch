diff --git a/tasks/task_save.c b/tasks/task_save.c
index 161fce6462..8aa2d020a3 100644
--- a/tasks/task_save.c
+++ b/tasks/task_save.c
@@ -794,6 +794,21 @@ static void task_save_handler(retro_task_t *task)
    }
    else if (state->written == state->size)
    {
+#ifdef HAVE_RICOTTA_OSD
+      /* Cannoli owns the save-state notification: emit a structured event
+       * (type 0 = save, 4 = undo-save; slot < 0 = auto) and skip native text.
+       * A save that also writes a thumbnail reports from save_state_cb instead,
+       * once that file is on disk: Cannoli reads the screenshot the moment it
+       * hears, and the state finishing here says nothing about the image. */
+      task_free_title(task);
+      if (!(state->flags & SAVE_TASK_FLAG_THUMBNAIL_ENABLE))
+      {
+         ricotta_osd_event((state->flags & SAVE_TASK_FLAG_UNDO_SAVE)
+               ? RICOTTA_OSD_UNDO_SAVE_STATE : RICOTTA_OSD_SAVE_STATE,
+               state->state_slot);
+      }
+      task_save_handler_finished(task, state);
+#else
       char       *msg      = NULL;
 
       RARCH_LOG("[State] save task COMPLETED for slot %d, path \"%s\" "
@@ -825,6 +840,7 @@ static void task_save_handler(retro_task_t *task)
 
       if (msg)
          free(msg);
+#endif
    }
 }
 
@@ -1060,6 +1076,12 @@ static void task_load_handler(retro_task_t *task)
    {
       task_free_title(task);
 
+#ifdef HAVE_RICOTTA_OSD
+      /* Cannoli owns the load-state notification (type 1; slot < 0 = auto). */
+      {
+         ricotta_osd_event(RICOTTA_OSD_LOAD_STATE, state->state_slot);
+      }
+#else
       if (!((flg & RETRO_TASK_FLG_MUTE) > 0))
       {
          char msg[128];
@@ -1082,6 +1104,7 @@ static void task_load_handler(retro_task_t *task)
 
          task_set_title(task, strdup(msg));
       }
+#endif
 
       task_load_handler_finished(task, state);
    }
@@ -1481,13 +1504,38 @@ static void save_state_cb(retro_task_t *task,
    {
       char               *path   = strdup(state->path);
       if (state->flags & SAVE_TASK_FLAG_THUMBNAIL_ENABLE)
-         take_screenshot(config_get_ptr()->paths.directory_screenshot,
+      {
+#ifdef HAVE_RICOTTA_OSD
+         /* Latched rather than raised here. The screenshot task raises it once the
+          * PNG is on disk, so the notification still cannot beat the file it names
+          * while the encode no longer runs on this thread. */
+         if (!error)
+            ricotta_osd_defer_save((state->flags & SAVE_TASK_FLAG_UNDO_SAVE)
+                  ? RICOTTA_OSD_UNDO_SAVE_STATE : RICOTTA_OSD_SAVE_STATE,
+                  state->state_slot);
+#endif
+         if (!take_screenshot(config_get_ptr()->paths.directory_screenshot,
                path, true,
-               state->flags & SAVE_TASK_FLAG_HAS_VALID_FB, false, true);
+               state->flags & SAVE_TASK_FLAG_HAS_VALID_FB, false, true))
+         {
+            /* The one blocking task slot was taken, so nothing was queued. Write it
+             * here instead: the stall is worth more than a missing thumbnail. */
+            take_screenshot(config_get_ptr()->paths.directory_screenshot,
+                  path, true,
+                  state->flags & SAVE_TASK_FLAG_HAS_VALID_FB, false, false);
+#ifdef HAVE_RICOTTA_OSD
+            ricotta_osd_flush_save();
+#endif
+         }
+      }
       free(path);
    }
 #endif
 
+#ifdef HAVE_RICOTTA_OSD
+   ricotta_save_end();
+#endif
+
    free(state);
 }
 
@@ -1554,6 +1602,10 @@ static void task_push_save_state(const char *path, void *data, size_t len, bool
       free(task);
       free(state);
    }
+#ifdef HAVE_RICOTTA_OSD
+   else
+      ricotta_save_begin();
+#endif
 
    return;
 
