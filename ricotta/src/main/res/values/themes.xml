<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Cannoli animates nothing anywhere, so RetroArch must not either. Suppressing the transition
      at the call site only covers the enter, and only for a start we make ourselves: the exit is
      the window animation of RetroArch's own theme, and when RetroArch ends by calling
      System.exit(0) there is no callback left to override it from.

      Parents match what phoenix declares, so nothing else about either window changes.
    -->

    <style name="Theme.Ricotta.Game" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@style/Animation.Cannoli.None</item>
    </style>

    <style name="Theme.Ricotta.Launch" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@style/Animation.Cannoli.None</item>
    </style>

</resources>
